# Copy this file to settings.env and customize values.
INGRESS_HOSTNAME=k8sgpt.example.com
IMAGE=ghcr.io/opswhisperer/k8sgpt-frontend:latest
CERT_ISSUER=letsencrypt-prod

# Notifications (leave APPRISE_URL empty to disable). If the URL embeds
# credentials, put it in a Secret named k8sgpt-frontend-secrets instead.
APPRISE_URL=
UI_URL=https://k8sgpt.example.com
APPRISE_FORMAT=html
NOTIFY_DELAY=300
POLL_INTERVAL=60

# OIDC login (leave OIDC_ISSUER empty for none). The callback is UI_URL + /auth/callback.
# Put OIDC_CLIENT_SECRET in the k8sgpt-frontend-secrets Secret, not here.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_ALLOWED_GROUPS=
